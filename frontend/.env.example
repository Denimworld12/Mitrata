# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Backend API base URL (no trailing slash, no /api suffix)
NEXT_PUBLIC_BACKEND_URL=

# Public site URL (no trailing slash) — used for canonical/OG tags, robots.txt
# and sitemap.xml. Must be the real domain search engines should index.
NEXT_PUBLIC_SITE_URL=

# Feature flags — "true" to enable, leave unset/false to hide until built out
NEXT_PUBLIC_ENABLE_REELS=false
NEXT_PUBLIC_ENABLE_GROUPS=false

# Google Sign-In (OAuth client ID) — must match the backend's GOOGLE_CLIENT_ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Push notifications (Firebase Cloud Messaging). Firebase Console > Project
# Settings > Cloud Messaging > Web configuration > "Generate key pair".
# Leave empty to keep push registration disabled — in-app notifications
# keep working either way.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Product analytics (posthog.com project settings > Project token/ID). Leave
# empty to keep client-side event tracking disabled.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
