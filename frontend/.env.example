# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Backend API base URL (no trailing slash, no /api suffix)
NEXT_PUBLIC_BACKEND_URL=

# Feature flags — "true" to enable, leave unset/false to hide until built out
NEXT_PUBLIC_ENABLE_REELS=false
NEXT_PUBLIC_ENABLE_GROUPS=false

# Google Sign-In (OAuth client ID) — must match the backend's GOOGLE_CLIENT_ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
