# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB Atlas connection string
MONGODB_URI=

# Cloudinary (media storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Auth token signing secrets — any long random string, keep these private
JWT_SECRET=
JWT_REFRESH_SECRET=

# The deployed frontend URL (used for CORS allow-list)
FRONTEND_URL=

# Google Sign-In — web and mobile are SEPARATE OAuth clients (different
# Google Cloud project numbers), each has its own audience check. Leave
# either empty to keep that platform's Google login disabled without
# affecting the other. GOOGLE_CLIENT_ID must match the frontend's
# NEXT_PUBLIC_GOOGLE_CLIENT_ID; GOOGLE_CLIENT_ID_MOBILE matches the mobile
# app's serverClientId (login_screen.dart).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID_MOBILE=

# OTP emails (signup verification, password reset) are sent from this address.
# EMAIL_APP_PASSWORD is a 16-char Gmail App Password (Google Account > Security
# > 2-Step Verification > App Passwords) — NOT the account's login password.
# Leave EMAIL_APP_PASSWORD empty to keep email sending disabled.
EMAIL_USER=
EMAIL_APP_PASSWORD=

# Push notifications (Firebase Cloud Messaging). The entire service-account
# JSON as one string (Firebase Console > Project Settings > Service Accounts
# > Generate new private key). Leave empty to keep push sends disabled —
# in-app/socket notifications keep working either way.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Error tracking (sentry.io project settings > Client Keys > DSN). Leave
# empty to keep error tracking disabled.
SENTRY_DSN=

# Product analytics (posthog.com project settings > Project token/ID). Leave
# empty to keep server-side event tracking disabled.
POSTHOG_API_KEY=
POSTHOG_HOST=

# Shared secret gating GET /api/cron/keep-warm (see .github/workflows/keep-warm.yml)
# — any long random string, e.g. `openssl rand -hex 24`.
CRON_SECRET=
